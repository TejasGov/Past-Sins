; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Blacksite: Ghost Exit"
run/main_scene="res://scenes/levels/campus/PrisonCampusPrototype.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.015, 0.02, 0.025, 1)

[autoload]

SuspicionSystem="*res://scripts/systems/suspicion_system.gd"
MemoryManager="*res://scripts/systems/memory_manager.gd"
InventoryManager="*res://scripts/systems/inventory_manager.gd"
AccessManager="*res://scripts/systems/access_manager.gd"
DevModeManager="*res://scripts/dev/dev_mode_manager.gd"

[blacksite]

development/dev_mode=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

