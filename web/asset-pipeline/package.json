{
  "name": "blacksite-asset-pipeline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Builds web-ready character GLBs from the Mixamo FBX sources in assets/characters/models_mixamo",
  "scripts": {
    "build:characters": "node scripts/build-characters.mjs",
    "fetch:props": "node scripts/fetch-polyhaven.mjs",
    "build:props": "node scripts/build-props.mjs",
    "viewer": "vite --config viewer/vite.config.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "fbx2gltf": "^0.9.7-p1",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "vite": "^8.3.4"
  }
}
