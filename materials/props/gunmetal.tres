[gd_resource type="StandardMaterial3D" load_steps=5 format=3]

; ambientCG Metal032, 1K-JPG, CC0. See docs/MATERIAL_REFERENCE.md.
; Authored PBR slots: swap these maps to replace this finish independently.
[ext_resource type="Texture2D" path="res://textures/gunmetal/gunmetal_albedo.jpg" id="1_albedo"]
[ext_resource type="Texture2D" path="res://textures/gunmetal/gunmetal_normal.jpg" id="2_normal"]
[ext_resource type="Texture2D" path="res://textures/gunmetal/gunmetal_roughness.jpg" id="3_roughness"]
[ext_resource type="Texture2D" path="res://textures/gunmetal/gunmetal_metalness.jpg" id="4_metalness"]

[resource]
resource_name = "Clean Cool Blued Gunmetal"
uv1_triplanar = true
uv1_world_triplanar = false
uv1_scale = Vector3(3, 3, 3)
albedo_color = Color(0.5, 0.58, 0.66, 1)
albedo_texture = ExtResource("1_albedo")
roughness = 0.5
roughness_texture = ExtResource("3_roughness")
roughness_texture_channel = 0
normal_enabled = true
normal_scale = 0.15
normal_texture = ExtResource("2_normal")
; Blued/coated finish: partial metallic keeps diffuse readability in Web rooms
; without requiring reflection probes or an expensive reflection pass.
metallic = 0.35
metallic_texture = ExtResource("4_metalness")
metallic_texture_channel = 0
metadata/mapping_space = "local"
metadata/ambientcg_asset_id = "Metal032"
